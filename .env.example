# --- Base de données -------------------------------------------------------
# Rôle applicatif (soumis au RLS) : utilisé par Next.js et Better Auth.
DATABASE_URL="postgresql://zahfit_app:zahfit_app_dev@localhost:5442/zahfit"
# Rôle propriétaire : utilisé uniquement par `prisma migrate`.
MIGRATE_DATABASE_URL="postgresql://zahfit_owner:zahfit_owner_dev@localhost:5442/zahfit"

# Tests d'intégration (base séparée, vidée à chaque exécution)
TEST_DATABASE_URL="postgresql://zahfit_app:zahfit_app_dev@localhost:5442/zahfit_test"
TEST_MIGRATE_DATABASE_URL="postgresql://zahfit_owner:zahfit_owner_dev@localhost:5442/zahfit_test"

# --- Authentification ------------------------------------------------------
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="remplacer-par-une-chaine-aleatoire-de-32-caracteres-min"
BETTER_AUTH_URL="http://localhost:3100"
# 2FA obligatoire pour les rôles sensibles (super-admin, admin, gérant)
ENFORCE_2FA="true"

# --- Paiement en ligne -----------------------------------------------------
# URL publique de l'application (liens de retour et notifications des prestataires)
APP_URL="http://localhost:3100"
# Prestataire actif : "sandbox" (simulateur, refusé en production) ou, à venir,
# l'adaptateur de l'agrégateur choisi (cinetpay, paydunya…)
PAYMENT_PROVIDER="sandbox"
PAYMENT_SANDBOX_SECRET="remplacer-par-un-secret-de-test"
# Protège /api/cron/paiements (rapprochement toutes les 5 minutes)
CRON_SECRET="remplacer-par-un-secret-aleatoire"

# --- E-mail (vide en local : les e-mails sont affichés dans la console) -----
RESEND_API_KEY=""
MAIL_FROM="ZAHFIT <no-reply@zahfit.local>"

# --- Comptes de démonstration créés par `pnpm db:seed` ---------------------
# Mot de passe commun aux comptes de démo (local uniquement).
SEED_PASSWORD="Zahfit-Demo-2026!"
