# --- Base de données -------------------------------------------------------
# Rôle applicatif (soumis au RLS) : utilisé par Next.js et Better Auth.
DATABASE_URL="postgresql://zahfit_app:zahfit_app_dev@localhost:5442/zahfit"
# Rôle propriétaire : utilisé uniquement par `prisma migrate`.
MIGRATE_DATABASE_URL="postgresql://zahfit_owner:zahfit_owner_dev@localhost:5442/zahfit"

# Tests d'intégration (base séparée, vidée à chaque exécution)
TEST_DATABASE_URL="postgresql://zahfit_app:zahfit_app_dev@localhost:5442/zahfit_test"
TEST_MIGRATE_DATABASE_URL="postgresql://zahfit_owner:zahfit_owner_dev@localhost:5442/zahfit_test"

# --- Authentification ------------------------------------------------------
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="remplacer-par-une-chaine-aleatoire-de-32-caracteres-min"
BETTER_AUTH_URL="http://localhost:3100"
# 2FA obligatoire pour les rôles sensibles (super-admin, admin, gérant)
ENFORCE_2FA="true"

# --- Paiement en ligne -----------------------------------------------------
# URL publique de l'application (liens de retour et notifications des prestataires)
APP_URL="http://localhost:3100"
# Prestataire actif : "sandbox" (simulateur, refusé en production) ou, à venir,
# l'adaptateur de l'agrégateur choisi (cinetpay, paydunya…)
PAYMENT_PROVIDER="sandbox"
PAYMENT_SANDBOX_SECRET="remplacer-par-un-secret-de-test"
# Protège les tâches planifiées : /api/cron/paiements (toutes les 5 minutes)
# /api/cron/planning (une fois par jour, prolonge le planning des cours) et
# /api/cron/notifications (toutes les heures : rappels d'échéance, e-mails en attente)
CRON_SECRET="remplacer-par-un-secret-aleatoire"

# --- Facturation ZahDigit -----------------------------------------------------
# Tâche quotidienne : /api/cron/facturation (avec CRON_SECRET) — fins d'essai,
# factures mensuelles, relances, lecture seule et suspension pour impayé.
# Mentions légales imprimées sur les factures (RCCM, n° de compte contribuable…)
ZAHDIGIT_LEGAL="ZahDigit — Abidjan, Côte d'Ivoire"

# --- Support ------------------------------------------------------------------
# Boîte de l'équipe support : avis de nouveaux tickets et de réponses des salles.
# Vide : aucun avis à l'équipe (les salles reçoivent toujours les réponses).
SUPPORT_EMAIL=""

# --- Contrôle d'accès --------------------------------------------------------
# Clé maîtresse des QR Codes d'entrée (obligatoire en production, ne quitte
# jamais le serveur). La changer invalide les QR et caches hors ligne en cours.
ACCESS_QR_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres"

# --- WhatsApp Cloud API (Meta) et SMS -----------------------------------------
# Vides en local : messages simulés, affichés dans la console ([whatsapp:dev]).
# En production, sans WHATSAPP_TOKEN, aucun message WhatsApp n'est envoyé.
# Modèles à faire valider : docs/WHATSAPP_MODELES.md
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANGUAGE="fr"
# Secret de l'application Meta : vérifie la signature des webhooks (obligatoire en production)
WHATSAPP_APP_SECRET=""
# Jeton choisi librement, saisi dans la configuration du webhook chez Meta
WHATSAPP_VERIFY_TOKEN="remplacer-par-un-jeton-aleatoire"
# Signe les liens de désinscription des SMS (obligatoire en production)
MESSAGING_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres"
# Coût unitaire refacturé à la salle (FCFA)
WHATSAPP_COST_XOF="25"
SMS_COST_XOF="20"

# --- E-mail (vide en local : les e-mails sont affichés dans la console) -----
RESEND_API_KEY=""
MAIL_FROM="ZAHFIT <no-reply@zahfit.local>"

# --- Comptes de démonstration créés par `pnpm db:seed` ---------------------
# Mot de passe commun aux comptes de démo (local uniquement).
SEED_PASSWORD="Zahfit-Demo-2026!"
