// ZAHFIT — schéma de données (Sprint 1 : identité, établissements, rôles, audit)
//
// Conventions :
//  - Tables et colonnes en snake_case (@@map / @map), modèles Prisma en PascalCase.
//  - Dates en timestamptz (UTC). Affichage en Africa/Abidjan côté application.
//  - Toute table métier porte `tenant_id` et est protégée par RLS
//    (voir prisma/migrations/*_rls/migration.sql).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identité (gérée par Better Auth) — tables GLOBALES, sans tenant_id :
// une même personne peut être coach dans une salle et adhérente dans une autre.
// ---------------------------------------------------------------------------

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  /// "SUPER_ADMIN" pour l'équipe ZahDigit, null pour tous les autres.
  platformRole     String?  @map("platform_role")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  memberships    TenantMembership[]
  memberProfiles Member[]
  notifications  Notification[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  /// false tant que l'utilisateur n'a pas validé son premier code TOTP
  verified                Boolean   @default(true)
  /// verrouillage après tentatives échouées (anti brute-force)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Multi-tenant
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Rôles À L'INTÉRIEUR d'un établissement (section 4 du cahier des charges).
/// Le Super Admin ZahDigit n'est pas ici : c'est User.platformRole.
enum TenantRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  COACH
  ACCOUNTANT
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Tenant {
  id                  String       @id @default(uuid(7)) @db.Uuid
  slug                String       @unique
  name                String
  status              TenantStatus @default(ACTIVE)
  phone               String?
  email               String?
  address             String?
  commune             String?
  city                String?
  timezone            String       @default("Africa/Abidjan")
  currency            String       @default("XOF")
  description         String?
  /// { "lun": "06:00-22:00", ..., "dim": null } — null = fermé
  openingHours        Json?        @map("opening_hours")
  /// { "facebook": url, "instagram": url, "tiktok": url, "website": url }
  socials             Json?
  logoUrl             String?      @map("logo_url")
  /// Compteur des codes adhérents (ADH-000001…), incrémenté en transaction
  memberSeq           Int          @default(0) @map("member_seq")
  suspendedReason     String?      @map("suspended_reason")
  // Paramètres d'encaissement (permission billing.settings.manage)
  /// Compteur des reçus (REC-000001…), incrémenté en transaction : aucun trou
  receiptSeq          Int          @default(0) @map("receipt_seq")
  /// Paiement en plusieurs fois autorisé ?
  allowPartialPayment Boolean      @default(false) @map("allow_partial_payment")
  /// Part minimale (en %) à encaisser pour activer l'abonnement
  minDepositPercent   Int          @default(100) @map("min_deposit_percent")
  /// Mention libre en bas des reçus (RCCM, n° compte contribuable…)
  receiptFooter       String?      @map("receipt_footer")
  /// Anti-passback : délai minimal (minutes) entre deux entrées d'un même adhérent ; 0 = désactivé
  antiPassbackMinutes Int          @default(60) @map("anti_passback_minutes")
  /// Réservations : ouverture N jours avant la séance, annulation libre jusqu'à N heures avant
  bookingOpenDays     Int          @default(7) @map("booking_open_days")
  bookingCancelHours  Int          @default(2) @map("booking_cancel_hours")
  /// Canaux payants activés par la salle (coût par message)
  whatsappEnabled     Boolean      @default(false) @map("whatsapp_enabled")
  smsEnabled          Boolean      @default(false) @map("sms_enabled")
  /// Caisse : encaissement en espèces refusé tant qu'aucune caisse n'est ouverte
  cashSessionRequired Boolean      @default(false) @map("cash_session_required")
  /// Compteur des tickets de vente boutique (VTE-000001…), incrémenté en transaction
  saleSeq             Int          @default(0) @map("sale_seq")
  /// Forfait ZAHFIT (fonctionnalités et limites). Par défaut : Premium (salles existantes inchangées)
  saasPlanId          String       @default(dbgenerated("'00000000-0000-7000-8000-000000000003'::uuid")) @map("saas_plan_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)

  memberships        TenantMembership[]
  auditLogs          AuditLog[]
  members            Member[]
  plans              MembershipPlan[]
  subscriptions      Subscription[]
  payments           Payment[]
  receipts           Receipt[]
  accessLogs         AccessLog[]
  rooms              Room[]
  classTypes         ClassType[]
  classSeries        ClassSeries[]
  classSessions      ClassSession[]
  bookings           Booking[]
  notifications      Notification[]
  messages           Message[]
  renewalLinks       RenewalLink[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  expenseAttachments ExpenseAttachment[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  products           Product[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleLines          SaleLine[]
  saasPlan           SaasPlan            @relation(fields: [saasPlanId], references: [id], onDelete: Restrict)

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Formules et abonnements (Module 3)
// ---------------------------------------------------------------------------

enum DurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

/// Formule commerciale d'une salle (journalier, mensuel, étudiant, VIP…).
/// Jamais supprimée : une formule retirée de la vente passe isActive=false.
model MembershipPlan {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  name          String
  description   String?
  /// Montant en francs CFA (entier, le XOF n'a pas de centimes)
  priceXof      Int          @map("price_xof")
  durationValue Int          @map("duration_value")
  durationUnit  DurationUnit @map("duration_unit")
  benefits      String[]     @default([])
  // Restrictions (appliquées au contrôle d'accès, Sprint 6)
  /// Jours autorisés 1 = lundi … 7 = dimanche ; vide = tous les jours
  allowedDays   Int[]        @default([]) @map("allowed_days")
  /// Créneau d'accès « HH:MM » ; null = horaires d'ouverture de la salle
  accessFrom    String?      @map("access_from")
  accessUntil   String?      @map("access_until")
  /// Nombre d'entrées sur la période ; null = illimité
  maxEntries    Int?         @map("max_entries")
  /// Jours de suspension (gel) autorisés par abonnement
  maxFreezeDays Int          @default(0) @map("max_freeze_days")
  isActive      Boolean      @default(true) @map("is_active")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, sortOrder])
  @@map("membership_plans")
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

/// Abonnement souscrit. Règle du cahier des charges : un renouvellement crée
/// une NOUVELLE ligne (previousId) — l'historique n'est jamais écrasé.
/// Le prix et la durée sont figés au moment de la vente.
model Subscription {
  id            String             @id @default(uuid(7)) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  memberId      String             @map("member_id") @db.Uuid
  planId        String             @map("plan_id") @db.Uuid
  planName      String             @map("plan_name")
  priceXof      Int                @map("price_xof")
  durationValue Int                @map("duration_value")
  durationUnit  DurationUnit       @map("duration_unit")
  /// Dates calendaires (fuseau Africa/Abidjan = UTC), fin INCLUSE
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  status        SubscriptionStatus @default(PENDING_PAYMENT)
  /// Début du gel en cours (status FROZEN)
  frozenSince   DateTime?          @map("frozen_since") @db.Date
  /// Jours de gel déjà consommés (plafonnés par maxFreezeDays)
  frozenDays    Int                @default(0) @map("frozen_days")
  // Restrictions FIGÉES à la vente (comme le prix) : modifier la formule
  // ne change pas les droits d'un abonnement déjà vendu.
  allowedDays   Int[]              @default([]) @map("allowed_days")
  accessFrom    String?            @map("access_from")
  accessUntil   String?            @map("access_until")
  maxEntries    Int?               @map("max_entries")
  previousId    String?            @map("previous_id") @db.Uuid
  activatedAt   DateTime?          @map("activated_at") @db.Timestamptz(3)
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?            @map("cancel_reason")
  createdById   String?            @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  previous     Subscription?  @relation("Renewal", fields: [previousId], references: [id], onDelete: Restrict)
  renewals     Subscription[] @relation("Renewal")
  renewalLinks RenewalLink[]  @relation("RenewalLinkSource")
  payments     Payment[]
  accessLogs   AccessLog[]

  @@index([tenantId, memberId, startDate])
  @@index([tenantId, status, endDate])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Paiements (Module 4 — encaissement manuel dès le Sprint 3)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentKind {
  PAYMENT
  REFUND
}

/// Transaction. Jamais supprimée (le rôle applicatif n'a pas le droit DELETE).
/// Seules les transactions SUCCEEDED comptent dans les statistiques.
/// Un remboursement est une NOUVELLE ligne (kind REFUND, refundOfId) :
/// chiffre d'affaires = encaissements − remboursements.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  memberId       String        @map("member_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  kind           PaymentKind   @default(PAYMENT)
  refundOfId     String?       @map("refund_of_id") @db.Uuid
  /// Motif obligatoire pour un remboursement
  reason         String?
  /// Toujours positif ; le sens est donné par `kind`
  amountXof      Int           @map("amount_xof")
  method         PaymentMethod
  /// "manual" (saisie à l'accueil) ; plus tard : agrégateur, orange, mtn, wave…
  provider       String        @default("manual")
  /// Référence de transaction (n° Mobile Money, virement…)
  providerRef    String?       @map("provider_ref")
  status         PaymentStatus @default(PENDING)
  collectedById  String?       @map("collected_by_id")
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// Paiement en ligne : au-delà, une tentative PENDING passe EXPIRED
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  refundOf     Payment?      @relation("Refunds", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds      Payment[]     @relation("Refunds")
  receipt      Receipt?
  cashMovement CashMovement?

  /// Une même référence d'opérateur ne peut pas être enregistrée deux fois
  @@unique([tenantId, provider, providerRef])
  @@index([tenantId, status, paidAt])
  @@index([tenantId, memberId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Adhérents (Module 2)
// ---------------------------------------------------------------------------

enum MemberStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberSource {
  RECEPTION
  ONLINE
  IMPORT
}

/// Fiche adhérent. Volontairement SANS champ libre de notes : le cahier des
/// charges exclut les données de santé du périmètre (section 9).
model Member {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  /// Code lisible unique dans la salle : ADH-000123
  code          String
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  /// Format E.164 normalisé (+2250701020304) : clé de dédoublonnage
  phone         String
  email         String?
  birthDate     DateTime?    @map("birth_date") @db.Date
  photoUrl      String?      @map("photo_url")
  /// Badge physique : seule l'empreinte SHA-256 du code est stockée
  badgeHash     String?      @map("badge_hash")
  /// 4 derniers caractères du code, pour reconnaître le badge à l'écran
  badgeHint     String?      @map("badge_hint")
  badgeIssuedAt DateTime?    @map("badge_issued_at") @db.Timestamptz(3)
  status        MemberStatus @default(ACTIVE)
  source        MemberSource @default(RECEPTION)
  /// Compte de connexion à l'espace adhérent (optionnel)
  userId        String?      @map("user_id")

  // Consentements (section 8 : communications commerciales)
  consentWhatsapp  Boolean   @default(false) @map("consent_whatsapp")
  consentSms       Boolean   @default(false) @map("consent_sms")
  consentEmail     Boolean   @default(false) @map("consent_email")
  consentUpdatedAt DateTime? @map("consent_updated_at") @db.Timestamptz(3)

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  payments      Payment[]
  accessLogs    AccessLog[]
  bookings      Booking[]
  notifications Notification[]
  messages      Message[]
  renewalLinks  RenewalLink[]
  sales         Sale[]

  @@unique([tenantId, code])
  @@unique([tenantId, badgeHash])
  @@unique([tenantId, phone])
  @@unique([tenantId, userId])
  @@index([tenantId, status, lastName])
  @@index([tenantId, createdAt])
  @@map("members")
}

model TenantMembership {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id")
  role         TenantRole
  status       MembershipStatus @default(ACTIVE)
  // Profil employé (propre à la salle) — Sprint 7
  phone        String?
  bio          String?
  specialties  String[]         @default([])
  /// Disponibilités hebdomadaires { "lun": ["06:00-12:00", "16:00-20:00"], … } ; null = non renseignées
  availability Json?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachedSeries   ClassSeries[]
  coachedSessions ClassSession[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Journal des opérations sensibles. En AJOUT SEUL : le rôle applicatif
/// n'a pas les droits UPDATE/DELETE sur cette table.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// null = événement plateforme (connexion, action Super Admin hors salle)
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Reçu (ou avoir pour un remboursement). Numéro séquentiel par salle,
/// sans trou. Immuable : le rôle applicatif ne peut ni le modifier ni le supprimer.
model Receipt {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// REC-000001 (paiement) ou AV-000002 (avoir de remboursement), même séquence
  number    String
  paymentId String   @unique @map("payment_id") @db.Uuid
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@map("receipts")
}

/// Notification serveur d'un prestataire de paiement (webhook). Stockée AVANT
/// traitement ; la clé unique (provider, eventId) rend le traitement
/// idempotent : une notification rejouée ne produit aucun effet.
model PaymentWebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  providerRef String    @map("provider_ref")
  status      String
  amountXof   Int?      @map("amount_xof")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  result      String?

  @@unique([provider, eventId])
  @@index([provider, providerRef])
  @@map("payment_webhook_events")
}

// --- Contrôle d'accès (Sprint 6) --------------------------------------------

enum AccessMethod {
  QR // QR dynamique de l'application adhérent
  BADGE // badge physique (code statique révocable)
}

enum AccessReason {
  GRANTED
  INVALID_CODE
  EXPIRED_CODE
  UNKNOWN_BADGE
  MEMBER_ARCHIVED
  MEMBER_SUSPENDED
  NO_SUBSCRIPTION
  SUBSCRIPTION_EXPIRED
  NOT_STARTED
  PAYMENT_PENDING
  SUBSCRIPTION_FROZEN
  SUBSCRIPTION_CANCELLED
  DAY_NOT_ALLOWED
  OUTSIDE_HOURS
  GYM_CLOSED
  QUOTA_REACHED
  PASSBACK
}

/// Journal des passages, autorisés OU refusés. Pièce de contrôle : ajout seul.
model AccessLog {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  memberId       String?      @map("member_id") @db.Uuid
  subscriptionId String?      @map("subscription_id") @db.Uuid
  method         AccessMethod
  granted        Boolean
  reason         AccessReason
  scannedById    String?      @map("scanned_by_id")
  /// Décision prise hors ligne par l'appareil, synchronisée ensuite
  offline        Boolean      @default(false)
  /// Identifiant généré par l'appareil : rend la synchronisation idempotente
  clientEventId  String?      @map("client_event_id") @db.Uuid
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  member       Member?       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientEventId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, memberId, occurredAt])
  @@index([subscriptionId, granted])
  @@map("access_logs")
}

// --- Cours collectifs et planning (Sprint 7) -------------------------------

/// Salle de cours (studio, plateau…) à l'intérieur de la salle de sport.
model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Capacité physique ; null = non limitée
  capacity  Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  series   ClassSeries[]
  sessions ClassSession[]

  @@unique([tenantId, name])
  @@map("rooms")
}

/// Type de cours (Yoga, Cross-training…) : valeurs par défaut des séances.
model ClassType {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  description     String?
  /// Couleur d'affichage dans le planning (#RRGGBB)
  color           String   @default("#E67334")
  durationMinutes Int      @default(60) @map("duration_minutes")
  defaultCapacity Int      @default(20) @map("default_capacity")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  series   ClassSeries[]
  sessions ClassSession[]

  @@unique([tenantId, name])
  @@map("class_types")
}

/// Cours régulier : un créneau hebdomadaire qui génère des séances.
model ClassSeries {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  classTypeId     String    @map("class_type_id") @db.Uuid
  coachId         String    @map("coach_id") @db.Uuid
  roomId          String?   @map("room_id") @db.Uuid
  /// 1 = lundi … 7 = dimanche
  weekday         Int
  /// Heure locale de la salle « HH:MM »
  startTime       String    @map("start_time")
  durationMinutes Int       @map("duration_minutes")
  capacity        Int
  startsOn        DateTime  @map("starts_on") @db.Date
  /// Dernier jour (inclus) ; null = sans fin
  endsOn          DateTime? @map("ends_on") @db.Date
  /// Séances générées jusqu'à cette date (incluse)
  generatedUntil  DateTime? @map("generated_until") @db.Date
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classType ClassType        @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  coach     TenantMembership @relation(fields: [coachId], references: [id], onDelete: Restrict)
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  sessions  ClassSession[]

  @@index([tenantId, endsOn])
  @@map("class_series")
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
}

/// Séance concrète (issue d'un cours régulier ou ponctuelle).
model ClassSession {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  seriesId       String?            @map("series_id") @db.Uuid
  /// Jour prévu par la série (identifie l'occurrence même si l'heure change)
  occurrenceDate DateTime?          @map("occurrence_date") @db.Date
  classTypeId    String             @map("class_type_id") @db.Uuid
  coachId        String             @map("coach_id") @db.Uuid
  roomId         String?            @map("room_id") @db.Uuid
  startsAt       DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime           @map("ends_at") @db.Timestamptz(3)
  capacity       Int
  /// Réservations CONFIRMÉES — tenu par un déclencheur, plafonné par CHECK (≤ capacity)
  bookedCount    Int                @default(0) @map("booked_count")
  status         ClassSessionStatus @default(SCHEDULED)
  cancelReason   String?            @map("cancel_reason")
  /// Modifiée individuellement : n'est plus réécrite par la série
  isException    Boolean            @default(false) @map("is_exception")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  series    ClassSeries?     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  classType ClassType        @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  coach     TenantMembership @relation(fields: [coachId], references: [id], onDelete: Restrict)
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bookings  Booking[]

  @@unique([seriesId, occurrenceDate])
  @@index([tenantId, startsAt])
  @@index([coachId, startsAt])
  @@map("class_sessions")
}

// --- Réservations et notifications (Sprint 8) ------------------------------

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/// Réservation d'une séance. Une seule réservation active par adhérent et
/// par séance (index unique partiel en SQL).
model Booking {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  sessionId            String            @map("session_id") @db.Uuid
  memberId             String            @map("member_id") @db.Uuid
  status               BookingStatus
  attendance           AttendanceStatus?
  attendanceMarkedAt   DateTime?         @map("attendance_marked_at") @db.Timestamptz(3)
  attendanceMarkedById String?           @map("attendance_marked_by_id")
  /// Qui a réservé : l'adhérent lui-même ou l'accueil
  bookedById           String?           @map("booked_by_id")
  promotedAt           DateTime?         @map("promoted_at") @db.Timestamptz(3)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason         String?           @map("cancel_reason")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  member  Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([sessionId, status, createdAt])
  @@index([tenantId, memberId, status])
  @@map("bookings")
}

enum NotificationType {
  MEMBER_WELCOME
  BOOKING_CONFIRMED
  BOOKING_WAITLISTED
  WAITLIST_PROMOTED
  BOOKING_CANCELLED
  SESSION_CANCELLED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  PAYMENT_CONFIRMED
}

enum EmailStatus {
  NONE
  PENDING
  SENT
  FAILED
}

/// Notification (dans l'application) + boîte d'envoi des e-mails : écrite
/// dans la transaction de l'événement, envoyée APRÈS validation.
model Notification {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  /// Destinataire dans l'application (compte de connexion) ; null = e-mail seul
  userId        String?          @map("user_id")
  memberId      String?          @map("member_id") @db.Uuid
  type          NotificationType
  title         String
  body          String
  link          String?
  /// Clé anti-doublon (ex. rappel J-7 d'un abonnement) ; unique par salle
  dedupeKey     String?          @map("dedupe_key")
  readAt        DateTime?        @map("read_at") @db.Timestamptz(3)
  emailStatus   EmailStatus      @default(NONE) @map("email_status")
  /// Adresse effacée après l'envoi (minimisation des données)
  emailTo       String?          @map("email_to")
  emailSubject  String?          @map("email_subject")
  emailText     String?          @map("email_text")
  emailAttempts Int              @default(0) @map("email_attempts")
  emailSentAt   DateTime?        @map("email_sent_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member   Member?   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  messages Message[]

  @@unique([tenantId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([emailStatus, createdAt])
  @@map("notifications")
}

// --- WhatsApp et SMS (Sprint 9) ----------------------------------------------

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Journal des envois WhatsApp / SMS (et file d'attente du worker). Le
/// numéro complet est effacé une fois le message parvenu à son statut final.
model Message {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  notificationId    String?        @map("notification_id") @db.Uuid
  memberId          String?        @map("member_id") @db.Uuid
  channel           MessageChannel
  provider          String
  /// Numéro E.164 (effacé après statut final) et sa version masquée (conservée)
  toPhone           String?        @map("to_phone")
  toMasked          String         @map("to_masked")
  /// Modèle WhatsApp approuvé par Meta (ou gabarit SMS)
  template          String
  variables         Json
  body              String
  status            MessageStatus  @default(QUEUED)
  providerMessageId String?        @map("provider_message_id")
  error             String?
  attempts          Int            @default(0)
  /// Coût facturé par le prestataire, en FCFA
  costXof           Int            @default(0) @map("cost_xof")
  /// SMS de secours : message WhatsApp d'origine
  fallbackOfId      String?        @unique @map("fallback_of_id") @db.Uuid
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  member       Member?       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fallbackOf   Message?      @relation("Fallback", fields: [fallbackOfId], references: [id], onDelete: SetNull)
  fallback     Message?      @relation("Fallback")

  @@unique([provider, providerMessageId])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("messages")
}

/// Lien de renouvellement en un clic : jeton aléatoire dont seule l'empreinte
/// est stockée ; à usage unique (consommé au paiement confirmé), expirant.
model RenewalLink {
  id                    String    @id @default(uuid(7)) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  memberId              String    @map("member_id") @db.Uuid
  /// Abonnement qui arrive à échéance (formule proposée au renouvellement)
  subscriptionId        String    @map("subscription_id") @db.Uuid
  tokenHash             String    @unique @map("token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Abonnement créé par ce lien (en attente puis payé)
  renewalSubscriptionId String?   @map("renewal_subscription_id") @db.Uuid
  usedAt                DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription Subscription @relation("RenewalLinkSource", fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([tenantId, subscriptionId])
  @@index([renewalSubscriptionId])
  @@map("renewal_links")
}

// ---------------------------------------------------------------------------
// Dépenses et caisse (Sprint 10)
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

enum ExpenseStatus {
  RECORDED
  /// Annulée (erreur de saisie) : jamais supprimée, l'historique reste lisible
  VOIDED
}

model Expense {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  label        String
  supplier     String?
  amountXof    Int           @map("amount_xof")
  spentOn      DateTime      @map("spent_on") @db.Date
  method       PaymentMethod
  /// N° de facture, de transaction Mobile Money…
  reference    String?
  note         String?
  status       ExpenseStatus @default(RECORDED)
  recordedById String        @map("recorded_by_id")
  voidReason   String?       @map("void_reason")
  voidedById   String?       @map("voided_by_id")
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category      ExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments   ExpenseAttachment[]
  cashMovements CashMovement[]

  @@index([tenantId, spentOn])
  @@map("expenses")
}

/// Justificatif (photo de facture, PDF) stocké en base : isolé par la RLS, sauvegardé avec le reste
model ExpenseAttachment {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  expenseId    String   @map("expense_id") @db.Uuid
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  data         Bytes
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([tenantId, expenseId])
  @@map("expense_attachments")
}

enum CashSessionStatus {
  OPEN
  /// Comptée et clôturée, en attente de validation par le gérant
  CLOSED
  VALIDATED
}

model CashSession {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openedById      String            @map("opened_by_id")
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  /// Fond de caisse compté à l'ouverture
  openingFloatXof Int               @map("opening_float_xof")
  closedById      String?           @map("closed_by_id")
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(3)
  /// Théorique = fond + mouvements ; compté = billets et pièces ; écart = compté − théorique
  expectedXof     Int?              @map("expected_xof")
  countedXof      Int?              @map("counted_xof")
  differenceXof   Int?              @map("difference_xof")
  closingNote     String?           @map("closing_note")
  validatedById   String?           @map("validated_by_id")
  validatedAt     DateTime?         @map("validated_at") @db.Timestamptz(3)
  validationNote  String?           @map("validation_note")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  movements CashMovement[]

  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

enum CashMovementKind {
  PAYMENT
  REFUND
  EXPENSE
  /// Annulation d'une dépense payée en espèces (contre-passation)
  EXPENSE_VOID
  /// Apport (ex. monnaie) et retrait (ex. remise en banque)
  DEPOSIT
  WITHDRAWAL
  /// Vente boutique en espèces, et son annulation
  SALE
  SALE_VOID
}

/// Mouvement d'espèces, immuable. Montant signé : + entrée, − sortie
model CashMovement {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  /// null : espèces encaissées alors qu'aucune caisse n'était ouverte (« hors caisse »)
  sessionId   String?          @map("session_id") @db.Uuid
  kind        CashMovementKind
  amountXof   Int              @map("amount_xof")
  label       String
  paymentId   String?          @unique @map("payment_id") @db.Uuid
  expenseId   String?          @map("expense_id") @db.Uuid
  saleId      String?          @map("sale_id") @db.Uuid
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session CashSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  payment Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expense Expense?     @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  sale    Sale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([expenseId, kind])
  @@unique([saleId, kind])
  @@index([tenantId, sessionId])
  @@index([tenantId, createdAt])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// Boutique (Sprint 11)
// ---------------------------------------------------------------------------

model Product {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String
  category          String?
  priceXof          Int      @map("price_xof")
  /// Prix d'achat unitaire indicatif (marge)
  costXof           Int?     @map("cost_xof")
  /// false : prestation sans stock (ex. location de serviette)
  trackStock        Boolean  @default(true) @map("track_stock")
  /// Tenu par la base à partir de stock_movements : jamais modifié directement
  stockQty          Int      @default(0) @map("stock_qty")
  /// Alerte quand le stock descend à ce niveau ou en dessous
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  saleLines      SaleLine[]

  @@index([tenantId, isActive])
  @@map("products")
}

enum StockMovementKind {
  /// Réception de marchandise
  RESTOCK
  SALE
  /// Annulation d'une vente : les articles reviennent en stock
  SALE_VOID
  /// Inventaire, casse, perte (quantité signée)
  ADJUSTMENT
}

/// Mouvement de stock, immuable. Quantité signée : + entrée, − sortie
model StockMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  kind        StockMovementKind
  quantity    Int
  /// Prix d'achat unitaire à la réception
  unitCostXof Int?              @map("unit_cost_xof")
  reason      String?
  saleId      String?           @map("sale_id") @db.Uuid
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
  @@map("stock_movements")
}

enum SaleStatus {
  COMPLETED
  /// Annulée (erreur, retour) : jamais supprimée
  VOIDED
}

model Sale {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  /// N° de ticket continu par salle : VTE-000001
  number     String
  /// Client adhérent (facultatif : un visiteur peut acheter)
  memberId   String?       @map("member_id") @db.Uuid
  totalXof   Int           @map("total_xof")
  method     PaymentMethod
  reference  String?
  status     SaleStatus    @default(COMPLETED)
  soldById   String        @map("sold_by_id")
  voidReason String?       @map("void_reason")
  voidedById String?       @map("voided_by_id")
  voidedAt   DateTime?     @map("voided_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  lines          SaleLine[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([tenantId, memberId])
  @@map("sales")
}

/// Ligne de vente : nom et prix FIGÉS au moment de la vente
model SaleLine {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  saleId       String @map("sale_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  productName  String @map("product_name")
  unitPriceXof Int    @map("unit_price_xof")
  quantity     Int
  lineTotalXof Int    @map("line_total_xof")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId])
  @@map("sale_lines")
}

// ---------------------------------------------------------------------------
// Forfaits SaaS ZahDigit (Sprint 12)
// ---------------------------------------------------------------------------

/// Modules activables selon le forfait (le socle adhérents/abonnements/paiements manuels est toujours inclus)
enum SaasFeature {
  /// Inscription et renouvellement en ligne (Mobile Money)
  ONLINE_PAYMENTS
  /// Contrôle d'accès par QR Code et badge
  ACCESS_CONTROL
  /// Planning des cours et réservations
  CLASSES
  /// Messages WhatsApp et SMS
  MESSAGING
  /// Statistiques avancées
  ADVANCED_REPORTS
  /// Boutique et stocks
  SHOP
}

/// Forfait commercial ZahDigit. Table de plateforme : lisible par tous, modifiable par le Super Admin seul
model SaasPlan {
  id                  String        @id @default(uuid(7)) @db.Uuid
  /// Code stable (STARTER, BUSINESS, PREMIUM…)
  code                String        @unique
  name                String
  description         String?
  monthlyPriceXof     Int           @map("monthly_price_xof")
  setupFeeXof         Int           @default(0) @map("setup_fee_xof")
  features            SaasFeature[]
  /// Limites : null = illimité
  maxMembers          Int?          @map("max_members")
  maxStaff            Int?          @map("max_staff")
  maxWhatsappPerMonth Int?          @map("max_whatsapp_per_month")
  isActive            Boolean       @default(true) @map("is_active")
  sortOrder           Int           @default(0) @map("sort_order")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenants Tenant[]

  @@map("saas_plans")
}
